# EquiFlow Environment Configuration

# Database (PostgreSQL 15+)
# Example: postgresql://postgres:password@localhost:5432/equiflow
# Or Cloud (e.g. Neon, Supabase): postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/equiflow?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/equiflow

# Redis Broker (Redis 7+ with Streams support)
# Example: redis://localhost:6379/0
# Or Cloud (e.g. Upstash): rediss://default:password@xyz.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Intelligence Engine
INTELLIGENCE_PORT=8000
FORMULA_VERSION=v2.0.0

# Ingestion Service
INGESTION_PORT=3001
GITHUB_WEBHOOK_SECRET=replace_with_github_secret
SLACK_SIGNING_SECRET=replace_with_slack_secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
